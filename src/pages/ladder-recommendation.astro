  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const step1 = document.getElementById('wizard-step-1');
      const step2 = document.getElementById('wizard-step-2');
      const result = document.getElementById('wizard-result');
      
      const resClient = document.getElementById('res-client');
      const resNode = document.getElementById('res-node');
      
      let selDevice = '';
      
      document.querySelectorAll('.device-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          selDevice = btn.getAttribute('data-val');
          
          step1.style.opacity = '0';
          setTimeout(() => {
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
            // trigger reflow
            void step2.offsetWidth;
            step2.style.opacity = '1';
          }, 300);
        });
      });

      document.querySelectorAll('.usage-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const usage = btn.getAttribute('data-usage');
          
          // Compute result
          if(selDevice === 'iPhone/iPad') {
            resClient.innerText = 'Shadowrocket / iOS 代理软件';
          } else if(selDevice === 'Android') {
            resClient.innerText = 'Clash Meta for Android';
          } else {
            resClient.innerText = 'Clash Verge Rev / Mihomo 类客户端';
          }
          
          if(usage === 'media') {
            resNode.innerText = '新加坡 / 美国 / 香港 原生流媒体节点';
          } else if(usage === 'ai') {
            resNode.innerText = '美国 / 日本 / 台湾 (低并发高纯净度 IP)';
          } else if(usage === 'game') {
            resNode.innerText = '日本 / 香港 (IPLC 或 IEPL 游戏专线)';
          } else {
            resNode.innerText = '香港 / 日本 / 新加坡 (BGP 中转节点)';
          }

          step2.style.opacity = '0';
          setTimeout(() => {
            step2.classList.add('hidden');
            result.classList.remove('hidden');
            void result.offsetWidth;
            result.style.opacity = '1';
          }, 300);
        });
      });

      document.getElementById('btn-restart').addEventListener('click', () => {
        result.style.opacity = '0';
        setTimeout(() => {
          result.classList.add('hidden');
          step1.classList.remove('hidden');
          void step1.offsetWidth;
          step1.style.opacity = '1';
          selDevice = '';
        }, 300);
      });
    });
  </script>
</Layout>
