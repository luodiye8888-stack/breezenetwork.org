---
import Layout from '../layouts/Layout.astro';
import { statusConfig, statusThresholds } from '../data/status';
---

<Layout 
  title="微风网络服务状态｜官网与服务可用性" 
  description="查看微风网络官网、套餐、线路、帮助中心与使用教程等服务的当前可访问状态及响应情况。"
>
  <main class="bg-[#0B1628] min-h-screen pt-24 pb-20 font-sans text-gray-300">
    <div class="max-w-5xl mx-auto px-4">
      
      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-3xl md:text-5xl font-black text-white mb-4 tracking-tight">微风网络服务状态</h1>
        <p class="text-lg text-gray-400">查看微风网络官网及相关服务的当前可访问状态。</p>
      </div>

      <!-- Global Status Overview -->
      <div class="bg-[#131F33] rounded-2xl p-6 border border-white/5 flex flex-col md:flex-row items-center justify-between mb-12 shadow-lg shadow-black/20" id="global-status-container">
        <div class="flex items-center gap-4 mb-4 md:mb-0">
          <div class="relative flex h-5 w-5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" id="global-pulse"></span>
            <span class="relative inline-flex rounded-full h-5 w-5" id="global-dot"></span>
          </div>
          <div>
            <div class="text-2xl font-bold text-white" id="global-text">正在初始化检测...</div>
            <div class="text-sm text-gray-400 mt-1">自动检测频率：30秒</div>
          </div>
        </div>
        <div class="flex flex-col md:flex-row items-center gap-4 text-sm font-mono text-gray-400">
          <div>最后检查: <span id="last-check-time">--</span></div>
          <div class="hidden md:block">|</div>
          <div>下一次检查: <span id="next-check-time" class="text-breeze-cyan">--</span></div>
          <button id="force-check-btn" class="ml-2 bg-white/5 hover:bg-white/10 px-4 py-2 rounded-lg border border-white/10 transition-colors text-white text-xs">立即重新检查</button>
        </div>
      </div>

      <!-- Services List -->
      <div class="space-y-4 mb-16" id="services-list">
        {statusConfig.map((item, index) => (
          <div class="bg-[#131F33] border border-white/5 rounded-2xl p-5 hover:border-white/10 transition-colors flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 service-card" data-url={item.url} data-index={index}>
            <div class="flex-grow">
              <h3 class="text-lg font-bold text-white mb-1">
                <a href={item.url} class="hover:text-breeze-cyan transition-colors" title={`访问 ${item.name}`}>
                  {item.name}
                  <svg class="w-4 h-4 inline-block ml-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </h3>
              <div class="flex items-center gap-2 text-sm">
                <span class="status-dot w-2 h-2 rounded-full bg-gray-600 transition-colors duration-500"></span>
                <span class="status-text font-medium text-gray-400 transition-colors">等待检测...</span>
                <span class="text-gray-600 mx-1">•</span>
                <span class="response-time text-gray-500 font-mono">-- ms</span>
              </div>
            </div>
            <div class="flex flex-col items-end gap-2 w-full sm:w-auto">
              <div class="text-xs text-gray-500 font-mono text-right w-full sm:w-auto">本次会话检测记录</div>
              <div class="sparkline flex gap-1 items-end h-6 overflow-hidden w-full sm:w-auto justify-end">
                <!-- Sparkline blocks will be injected here -->
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Network Nodes Notice -->
      <div class="bg-blue-500/10 border border-blue-500/20 rounded-xl p-6 text-sm text-blue-200/80 flex items-start gap-4 mb-16">
        <svg class="w-6 h-6 flex-shrink-0 mt-0.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <div>
          <strong class="block text-blue-300 text-base mb-1">微风网络实际连接节点可用性</strong>
          本页面主要用于监控微风网络官网及周边门户服务的在线状态。关于跨境网络连接线路（如香港、日本、美国专线）的具体节点可用情况、维护通告及实时延迟，请以登录微风网络用户中心后显示的订阅看板为准。
        </div>
      </div>


      <!-- Internal Linking Hub / Contextual Nav -->
      <div class="border-t border-white/10 pt-8 mt-12 mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-gray-400 text-sm">
          发现服务状态异常？
        </div>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <a href="/" class="text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 px-4 py-2 rounded-lg border border-white/5 transition-colors">返回首页</a>
          <a href="/help" class="text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 px-4 py-2 rounded-lg border border-white/5 transition-colors">排查故障 (帮助中心)</a>
          <a href="/network" class="text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 px-4 py-2 rounded-lg border border-white/5 transition-colors">查看网络线路</a>
          <a href="/pricing" class="text-breeze-cyan hover:text-white bg-breeze-cyan/10 hover:bg-breeze-cyan/20 px-4 py-2 rounded-lg border border-breeze-cyan/20 transition-colors font-medium">了解更多套餐</a>
        </div>
      </div>
    </div>
  </main>

  <style>
    .sparkline-block {
      width: 6px;
      height: 100%;
      border-radius: 1px;
      transition: height 0.3s ease, background-color 0.3s ease;
      opacity: 0;
      animation: fadeIn 0.3s forwards;
    }
    @keyframes fadeIn {
      to { opacity: 1; }
    }
  </style>

  <script define:vars={{ statusConfig, statusThresholds }}>
    document.addEventListener('DOMContentLoaded', () => {
      const globalPulse = document.getElementById('global-pulse');
      const globalDot = document.getElementById('global-dot');
      const globalText = document.getElementById('global-text');
      const lastCheckTimeEl = document.getElementById('last-check-time');
      const nextCheckTimeEl = document.getElementById('next-check-time');
      const forceCheckBtn = document.getElementById('force-check-btn');
      
      const REFRESH_INTERVAL = 30; // seconds
      let countdown = REFRESH_INTERVAL;
      let countdownTimer = null;
      let isChecking = false;

      // Store history for sparklines (max 20)
      const MAX_HISTORY = 20;
      const historyData = statusConfig.map(() => []);

      function formatTime(date) {
        return date.toLocaleTimeString('zh-CN', { hour12: false });
      }

      function updateGlobalStatus(hasError, hasDegraded) {
        globalPulse.className = 'animate-ping absolute inline-flex h-full w-full rounded-full opacity-75';
        globalDot.className = 'relative inline-flex rounded-full h-5 w-5 transition-colors duration-500';
        
        if (hasError) {
          globalPulse.classList.add('bg-red-400');
          globalDot.classList.add('bg-red-500');
          globalText.textContent = '部分服务发生中断';
          globalText.className = 'text-2xl font-bold text-red-500 transition-colors';
          document.getElementById('global-status-container').classList.add('border-red-500/30');
          document.getElementById('global-status-container').classList.remove('border-white/5', 'border-yellow-500/30');
        } else if (hasDegraded) {
          globalPulse.classList.add('bg-yellow-400');
          globalDot.classList.add('bg-yellow-500');
          globalText.textContent = '部分服务响应较慢';
          globalText.className = 'text-2xl font-bold text-yellow-500 transition-colors';
          document.getElementById('global-status-container').classList.add('border-yellow-500/30');
          document.getElementById('global-status-container').classList.remove('border-white/5', 'border-red-500/30');
        } else {
          globalPulse.classList.add('bg-green-400');
          globalDot.classList.add('bg-green-500');
          globalText.textContent = '所有服务运行正常';
          globalText.className = 'text-2xl font-bold text-green-500 transition-colors';
          document.getElementById('global-status-container').classList.remove('border-red-500/30', 'border-yellow-500/30');
          document.getElementById('global-status-container').classList.add('border-white/5');
        }
      }

      function renderSparkline(card, index, stateClass) {
        const sparklineContainer = card.querySelector('.sparkline');
        const history = historyData[index];
        history.push(stateClass);
        if (history.length > MAX_HISTORY) history.shift();
        
        sparklineContainer.innerHTML = '';
        history.forEach((state) => {
          const block = document.createElement('div');
          block.className = 'sparkline-block';
          
          if (state === 'green') {
            block.style.backgroundColor = '#10B981'; // Tailwind green-500
            block.style.height = '100%';
          } else if (state === 'yellow') {
            block.style.backgroundColor = '#F59E0B'; // Tailwind yellow-500
            block.style.height = '60%';
          } else {
            block.style.backgroundColor = '#EF4444'; // Tailwind red-500
            block.style.height = '30%';
          }
          sparklineContainer.appendChild(block);
        });
      }

      async function checkService(card, url, index) {
        const dot = card.querySelector('.status-dot');
        const text = card.querySelector('.status-text');
        const timeText = card.querySelector('.response-time');
        
        dot.className = 'status-dot w-2 h-2 rounded-full animate-pulse bg-gray-400';
        text.textContent = '检测中...';
        text.className = 'status-text font-medium text-gray-400';
        
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), statusThresholds.timeout);
        
        const start = performance.now();
        let resultState = 'red'; // default fail
        
        try {
          // Use no-cache to force real network request to our own endpoints
          const response = await fetch(url, { 
            method: 'HEAD',
            cache: 'no-store',
            signal: controller.signal 
          });
          const duration = Math.round(performance.now() - start);
          clearTimeout(timeoutId);
          
          if (response.ok) {
            timeText.textContent = duration + ' ms';
            if (duration < statusThresholds.degraded) {
              resultState = 'green';
              dot.className = 'status-dot w-2 h-2 rounded-full bg-green-500 transition-colors shadow-[0_0_10px_rgba(16,185,129,0.6)]';
              text.textContent = '运行正常';
              text.className = 'status-text font-medium text-green-400 transition-colors';
            } else if (duration < statusThresholds.disrupted) {
              resultState = 'yellow';
              dot.className = 'status-dot w-2 h-2 rounded-full bg-yellow-500 transition-colors shadow-[0_0_10px_rgba(245,158,11,0.6)]';
              text.textContent = '响应较慢';
              text.className = 'status-text font-medium text-yellow-400 transition-colors';
            } else {
              resultState = 'red';
              dot.className = 'status-dot w-2 h-2 rounded-full bg-red-500 transition-colors shadow-[0_0_10px_rgba(239,68,68,0.6)]';
              text.textContent = '性能下降';
              text.className = 'status-text font-medium text-red-400 transition-colors';
            }
          } else {
            resultState = 'red';
            timeText.textContent = 'Error ' + response.status;
            dot.className = 'status-dot w-2 h-2 rounded-full bg-red-500 transition-colors shadow-[0_0_10px_rgba(239,68,68,0.6)]';
            text.textContent = '暂时不可访问';
            text.className = 'status-text font-medium text-red-400 transition-colors';
          }
        } catch (error) {
          resultState = 'red';
          timeText.textContent = error.name === 'AbortError' ? 'Timeout' : 'Network Error';
          dot.className = 'status-dot w-2 h-2 rounded-full bg-red-500 transition-colors shadow-[0_0_10px_rgba(239,68,68,0.6)]';
          text.textContent = '暂时不可访问';
          text.className = 'status-text font-medium text-red-400 transition-colors';
        }
        
        renderSparkline(card, index, resultState);
        return resultState;
      }

      async function runHealthChecks() {
        if (isChecking) return;
        isChecking = true;
        
        globalText.textContent = '执行检测中...';
        globalText.className = 'text-2xl font-bold text-gray-400';
        globalPulse.className = 'animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-gray-400';
        globalDot.className = 'relative inline-flex rounded-full h-5 w-5 bg-gray-500';
        
        forceCheckBtn.disabled = true;
        forceCheckBtn.classList.add('opacity-50', 'cursor-not-allowed');

        const cards = document.querySelectorAll('.service-card');
        let hasError = false;
        let hasDegraded = false;

        // Run checks concurrently
        const promises = Array.from(cards).map((card) => {
          const url = card.getAttribute('data-url');
          const index = parseInt(card.getAttribute('data-index'), 10);
          return checkService(card, url, index);
        });

        const results = await Promise.all(promises);
        
        results.forEach(res => {
          if (res === 'red') hasError = true;
          if (res === 'yellow') hasDegraded = true;
        });

        updateGlobalStatus(hasError, hasDegraded);
        
        lastCheckTimeEl.textContent = formatTime(new Date());
        countdown = REFRESH_INTERVAL;
        isChecking = false;
        
        forceCheckBtn.disabled = false;
        forceCheckBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }

      function startTimer() {
        if (countdownTimer) clearInterval(countdownTimer);
        countdownTimer = setInterval(() => {
          if (isChecking) return;
          countdown--;
          nextCheckTimeEl.textContent = countdown + ' 秒';
          if (countdown <= 0) {
            runHealthChecks();
          }
        }, 1000);
      }

      forceCheckBtn.addEventListener('click', () => {
        countdown = REFRESH_INTERVAL;
        runHealthChecks();
      });

      // Initial run
      runHealthChecks().then(() => startTimer());
    });
  </script>
</Layout>