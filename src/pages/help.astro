  <!-- 搜索与诊断器脚本 -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. 搜索过滤功能
      const searchInput = document.getElementById('help-search');
      const faqItems = document.querySelectorAll('.faq-item');
      
      searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        faqItems.forEach(item => {
          const q = item.querySelector('summary').innerText.toLowerCase();
          const a = item.querySelector('.faq-answer').innerText.toLowerCase();
          if(q.includes(term) || a.includes(term)) {
            item.style.display = 'block';
            if(term.length > 1) {
              item.setAttribute('open', ''); // 自动展开匹配项
            }
          } else {
            item.style.display = 'none';
          }
        });
      });

      // 2. 互动诊断器逻辑
      const tsContainer = document.getElementById('ts-container');
      const tsQ = document.getElementById('ts-question');
      const tsOpts = document.getElementById('ts-options');

      const tsData = {
        start: {
          q: "你遇到了什么主要问题？",
          opts: [
            { t: "完全无法上网 / 打不开网页", next: "no_net" },
            { t: "订阅报错 / 节点消失", next: "sub_err" },
            { t: "速度很慢 / 频繁断线", next: "slow" }
          ]
        },
        no_net: {
          q: "在客户端中测试节点延迟，有绿色数字吗？",
          opts: [
            { t: "有，显示了 ms 数字", next: "has_ping" },
            { t: "没有，全是 Timeout", next: "timeout" },
            { t: "不知道怎么看", next: "start" }
          ]
        },
        has_ping: {
          q: "节点本身畅通，这通常是本地设置问题：",
          res: "1. 请检查并开启客户端中的【System Proxy / 系统代理】开关。<br>2. 关闭浏览器中可能冲突的插件（如去广告插件）。<br>3. 尝试重启电脑或手机。"
        },
        timeout: {
          q: "说明无法连接到远端服务器，建议：",
          res: "1. 请确保您的套餐未过期。<br>2. 点击客户端的【更新订阅】。<br>3. 前往 /status 查看是否发生了大规模区域中断。"
        },
        sub_err: {
          q: "订阅无法更新，请尝试：",
          res: "订阅更新需要连接官网后台。请随便选中一个目前仍然可用的节点，在【翻墙成功的状态下】再点击更新订阅。如果仍报错，请检查官网是否正在维护。"
        },
        slow: {
          q: "网络缓慢有多种原因，建议：",
          res: "1. 尝试将模式切换为 Rule(规则)，避免国内网站也绕路国外。<br>2. 切换到其他国家节点测试是否是单点故障。<br>3. 晚高峰请尽量使用中转或专线节点。"
        }
      };

      const renderState = (stateKey) => {
        tsContainer.style.opacity = '0';
        setTimeout(() => {
          const step = tsData[stateKey];
          tsQ.innerText = step.q;
          tsOpts.innerHTML = '';

          if(step.res) {
            // End result
            tsOpts.innerHTML = `
              <div class="text-gray-300 text-sm leading-relaxed mb-6 bg-breeze-cyan/10 p-5 rounded-xl border border-breeze-cyan/20">
                ${step.res}
              </div>
              <div class="flex gap-4">
                <button class="ts-reset text-gray-500 hover:text-white text-sm underline transition-colors">重新测试</button>
                <a href="#cat-connect" class="text-breeze-cyan text-sm font-bold hover:underline">查看更详细教程</a>
              </div>
            `;
            // Bind reset
            tsOpts.querySelector('.ts-reset').addEventListener('click', () => renderState('start'));
          } else {
            // Options
            step.opts.forEach(opt => {
              const btn = document.createElement('button');
              btn.className = "bg-[#131F33] hover:bg-breeze-blue text-white px-6 py-4 rounded-xl border border-white/10 hover:border-breeze-blue transition-all shadow-lg text-sm md:text-base font-medium flex-1 min-w-[200px]";
              btn.innerText = opt.t;
              btn.addEventListener('click', () => renderState(opt.next));
              tsOpts.appendChild(btn);
            });
          }
          tsContainer.style.opacity = '1';
        }, 200);
      };

      // Init
      renderState('start');
    });
  </script>
</Layout>
