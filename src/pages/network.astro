---
import Layout from '../layouts/Layout.astro';
import { networkRegions } from '../data/network';
---

<Layout 
  title="微风网络线路与节点｜IPLC・IEPL・中转网络说明" 
  description="了解微风网络的线路与节点架构，包括 IPLC、IEPL、中转与直连线路的区别，以及延迟、晚高峰稳定性和不同网络使用场景的选择方法。"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://breezenetwork.org/network" />
    <meta property="og:title" content="微风网络线路与节点｜IPLC・IEPL・中转网络说明" />
    <meta property="og:description" content="了解微风网络的线路与节点架构，包括 IPLC、IEPL、中转与直连线路的区别，以及延迟、晚高峰稳定性和不同网络使用场景的选择方法。" />
    <meta property="og:url" content="https://breezenetwork.org/network" />
    <meta property="og:type" content="article" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "微风网络线路与节点｜IPLC・IEPL・中转网络说明",
        "description": "了解微风网络的线路与节点架构，包括 IPLC、IEPL、中转与直连线路的区别，以及延迟、晚高峰稳定性和不同网络使用场景的选择方法。",
        "url": "https://breezenetwork.org/network",
        "inLanguage": "zh-CN",
        "author": {
          "@type": "Organization",
          "name": "微风网络",
          "url": "https://breezenetwork.org/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "微风网络",
          "logo": {
            "@type": "ImageObject",
            "url": "https://breezenetwork.org/logo.png"
          }
        },
        "dateModified": "2026-09-23T00:00:00Z"
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "首页",
            "item": "https://breezenetwork.org/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "线路与节点",
            "item": "https://breezenetwork.org/network"
          }
        ]
      }
    </script>
  </Fragment>

  <!-- Hero Section -->
  <section class="relative py-24 px-4 overflow-hidden border-b border-white/5 bg-breeze-dark">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-breeze-blue rounded-full mix-blend-screen filter blur-[128px]"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl text-white font-bold mb-6 leading-tight tracking-tight">微风网络线路与节点</h1>
      <p class="text-lg md:text-xl text-gray-400 mb-10 leading-relaxed">
        了解微风网络的线路结构、节点覆盖与不同网络连接方式。
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/pricing" class="bg-breeze-cyan text-[#0B1628] font-bold px-8 py-3 rounded-lg hover:bg-cyan-400 transition-colors">查看套餐</a>
        <a href="/status" class="bg-[#131F33] text-white border border-gray-700 px-8 py-3 rounded-lg hover:border-gray-500 transition-colors">查看服务状态</a>
      </div>
    </div>
  </section>

  <main class="bg-breeze-dark py-16 px-4 font-sans text-gray-300">
    <div class="max-w-4xl mx-auto space-y-20">
      
      <!-- Section 1: 线路覆盖 -->
      <section>
        <h2 class="text-3xl font-bold text-white mb-8 border-b border-white/10 pb-4">1. 节点区域覆盖</h2>
        <p class="mb-8 leading-relaxed">我们致力于为用户提供就近接入的优质体验。以下是微风网络当前支持的主要节点区域分布：</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {networkRegions.map(region => (
            <div class="bg-[#131F33] border border-white/5 rounded-xl p-5 hover:border-breeze-cyan/50 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <span class="text-white font-bold text-lg">{region.region}</span>
                <span class="text-xs font-mono bg-white/10 text-gray-400 px-2 py-1 rounded">{region.code}</span>
              </div>
              <p class="text-sm text-gray-400 mb-4 h-10">{region.description}</p>
              {region.statusAvailable && (
                <div class="flex items-center gap-2 text-xs text-green-400 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>当前提供
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Section 2: 线路类型 -->
      <section>
        <h2 class="text-3xl font-bold text-white mb-8 border-b border-white/10 pb-4">2. 常见网络线路类型</h2>
        <p class="mb-8 leading-relaxed">不同的业务场景需要不同级别的底层网络支撑。以下是目前跨境网络通信中常见的线路架构说明：</p>
        <div class="space-y-6">
          <div class="bg-[#131F33] border border-white/5 p-6 rounded-xl">
            <h3 class="text-xl font-bold text-breeze-cyan mb-2">IPLC / IEPL 国际专线</h3>
            <p class="text-gray-400 text-sm leading-relaxed">IPLC (International Private Leased Circuit) 与 IEPL 均属于点对点物理/逻辑专线。它们不经过传统的公网路由，不受国际出口防火墙的拥堵影响，能够提供几乎无波动的超低延迟连接，是晚高峰稳定性的天花板。</p>
          </div>
          <div class="bg-[#131F33] border border-white/5 p-6 rounded-xl">
            <h3 class="text-xl font-bold text-breeze-cyan mb-2">BGP 国内中转优化线路</h3>
            <p class="text-gray-400 text-sm leading-relaxed">数据先接入国内边缘 BGP 多线机房，随后通过企业级隧道加密传输至海外服务器。这种方式能有效缓解普通宽带跨网调度的延迟，大幅提升数据吞吐量。</p>
          </div>
          <div class="bg-[#131F33] border border-white/5 p-6 rounded-xl">
            <h3 class="text-xl font-bold text-breeze-cyan mb-2">公网直连 (CN2 GIA 等)</h3>
            <p class="text-gray-400 text-sm leading-relaxed">设备直接通过运营商骨干网访问海外服务器。虽然部分优质骨干网（如电信 CN2 GIA）表现出色，但在极端网络波动期仍可能面临公网统一的拥堵问题。</p>
          </div>
        </div>
      </section>

      <!-- Section 3: 为什么体验不同 -->
      <section>
        <h2 class="text-3xl font-bold text-white mb-8 border-b border-white/10 pb-4">3. 为什么不同线路的体验差异巨大？</h2>
        <div class="prose prose-invert max-w-none text-gray-400">
          <p>许多用户在搜索<strong>专线机场推荐</strong>或<strong>低延迟机场</strong>时，常常疑惑：为什么都是连到香港，体验却天差地别？</p>
          <ul class="leading-relaxed">
            <li><strong>晚高峰拥塞程度：</strong> 每天晚上 8 点至 11 点，国际出口带宽压力剧增。普通直连线路在此期间容易遭遇大规模丢包，而专线（IPLC/IEPL）独立于公网之外，因此能保持<strong>晚高峰稳定</strong>。</li>
            <li><strong>路由距离与绕路：</strong> 部分低价线路可能由于运营商 BGP 宣告问题，数据会先绕道美国再折返亚洲，导致延迟翻倍。</li>
            <li><strong>节点负载与带宽：</strong> 优秀的网络服务会严格限制单台服务器的并发承载量，避免“拥挤的早高峰地铁”效应。</li>
          </ul>
        </div>
      </section>

      <!-- Section 4: 场景选择 -->
      <section>
        <h2 class="text-3xl font-bold text-white mb-8 border-b border-white/10 pb-4">4. 匹配您的使用场景</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-[#0B1628] border border-white/10 p-6 rounded-xl relative overflow-hidden">
            <h3 class="text-white font-bold mb-2">日常浏览与社交</h3>
            <p class="text-sm text-gray-400 mb-4">追求网页秒开与图文加载顺畅。</p>
            <div class="text-xs text-breeze-cyan bg-breeze-cyan/10 px-2 py-1 rounded inline-block">关注重点：日常延迟、性价比</div>
          </div>
          <div class="bg-[#0B1628] border border-white/10 p-6 rounded-xl relative overflow-hidden">
            <h3 class="text-white font-bold mb-2">流媒体观影 (4K/8K)</h3>
            <p class="text-sm text-gray-400 mb-4">需要持续不断的大流量吞吐与地区解锁。</p>
            <div class="text-xs text-breeze-cyan bg-breeze-cyan/10 px-2 py-1 rounded inline-block">关注重点：原生 IP 质量、带宽上限</div>
          </div>
          <div class="bg-[#0B1628] border border-white/10 p-6 rounded-xl relative overflow-hidden">
            <h3 class="text-white font-bold mb-2">AI 工具与开发</h3>
            <p class="text-sm text-gray-400 mb-4">避免请求超时与频繁的风控弹窗。</p>
            <div class="text-xs text-breeze-cyan bg-breeze-cyan/10 px-2 py-1 rounded inline-block">关注重点：IP 纯净度、连接稳定性</div>
          </div>
          <div class="bg-[#0B1628] border border-white/10 p-6 rounded-xl relative overflow-hidden">
            <h3 class="text-white font-bold mb-2">游戏与远程办公</h3>
            <p class="text-sm text-gray-400 mb-4">对丢包零容忍，需要极致的网络抖动控制。</p>
            <div class="text-xs text-breeze-cyan bg-breeze-cyan/10 px-2 py-1 rounded inline-block">关注重点：IPLC 专线、极低丢包率</div>
          </div>
        </div>
      </section>

      <!-- Section 5: 节点误区 -->
      <section>
        <h2 class="text-3xl font-bold text-white mb-8 border-b border-white/10 pb-4">5. 节点数量不等于网络质量</h2>
        <div class="bg-white/5 rounded-xl p-8 border border-white/10">
          <p class="text-gray-300 leading-relaxed mb-4">
            许多新手用户喜欢追求拥有几百个甚至上千个节点的列表。然而，<strong>节点数量并不是判断网络质量的唯一标准。</strong>
          </p>
          <p class="text-gray-400 leading-relaxed text-sm">
            真正决定体验的是：<strong>单节点的线路质量、维护团队的响应速度，以及底层路由的稳定性。</strong> 10 条高质量的物理专线，在实际使用中的体验远胜于 100 条经常掉线、需要反复切换的廉价 VPS 节点。我们建议用户更应关注晚高峰表现与长期维护能力。
          </p>
        </div>
      </section>

      <!-- Section 6: FAQ -->
      <section>
        <h2 class="text-3xl font-bold text-white mb-8 border-b border-white/10 pb-4">6. 常见问题解答</h2>
        <div class="space-y-4">
          
          <details class="group bg-[#131F33] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-medium cursor-pointer p-6 text-white hover:text-breeze-cyan transition-colors">
              <span>IPLC 和 IEPL 有什么区别？</span>
            </summary>
            <div class="text-gray-400 px-6 pb-6 text-sm leading-relaxed border-t border-white/5 pt-4">
              两者同属高端跨境专线。IPLC (国际私有租用线路) 是传统的端到端物理专线；IEPL (国际以太网专线) 基于二层以太网架构，配置更灵活。在实际用户体验上，两者的延迟和稳定性几乎一样优秀，均不经过公网防火墙，适合要求极高的场景。
            </div>
          </details>

          <details class="group bg-[#131F33] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-medium cursor-pointer p-6 text-white hover:text-breeze-cyan transition-colors">
              <span>为什么延迟低但速度不一定快？</span>
            </summary>
            <div class="text-gray-400 px-6 pb-6 text-sm leading-relaxed border-t border-white/5 pt-4">
              “延迟（Ping）”衡量的是数据包往返的时间，而“速度”取决于链路的带宽上限。就像一条不堵车的小巷子，车开得很快（低延迟），但能同时并排跑的车很少（低带宽），所以下载大文件依然会慢。
            </div>
          </details>

          <details class="group bg-[#131F33] rounded-xl border border-white/5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-medium cursor-pointer p-6 text-white hover:text-breeze-cyan transition-colors">
              <span>为什么部分节点会临时维护？</span>
            </summary>
            <div class="text-gray-400 px-6 pb-6 text-sm leading-relaxed border-t border-white/5 pt-4">
              海外数据中心会定期进行电力轮转、硬件升级或上游路由调整。为确保长期稳定，机房临时切割或升级是正常的运维操作。如果您遇到节点不可用，可随时前往<a href="/help" class="text-breeze-cyan hover:underline">帮助中心</a>或查看最新的维护通告。
            </div>
          </details>

        </div>
      </section>

      <!-- Bottom Links -->
      <div class="border-t border-white/10 pt-8 flex flex-wrap gap-4 text-sm">
        <a href="/airport-recommendation" class="text-gray-400 hover:text-white transition-colors">阅读机场选购指南</a>
        <span class="text-gray-700 hidden sm:inline">|</span>
        <a href="/dedicated-line" class="text-gray-400 hover:text-white transition-colors">深入了解专线网络</a>
      </div>
      
    </div>
  </main>
</Layout>
